{
  "title": "Subsets",
  "difficulty": "easy",
  "args": [
    "integer[]"
  ],
  "returnType": "integer[][]",
  "constraints": [
    "1 <= nums.length <= 10",
    "-10 <= nums[i] <= 10",
    "All the numbers of nums are unique."
  ],
  "description": "Given an integer array `nums` of **unique** elements, return **all possible subsets** (the power set).\n\nThe solution set **must not** contain duplicate subsets. Return the solution in **any order**.\n\nFor an array of length `n`, there are exactly `2^n` subsets (including the empty set).",
  "tests": [
    {
      "input": "[1,2,3]",
      "expected": "[[],[1],[2],[1,2],[3],[1,3],[2,3],[1,2,3]]",
      "explanation": "All 2^3 = 8 subsets of [1,2,3]. Order does not matter.",
      "is_single_array_arg": true,
      "orderIndependent": true,
      "isSample": true
    },
    {
      "input": "[0]",
      "expected": "[[],[0]]",
      "is_single_array_arg": true,
      "orderIndependent": true,
      "isSample": true
    },
    {
      "input": "[1,2]",
      "expected": "[[],[1],[2],[1,2]]",
      "is_single_array_arg": true,
      "orderIndependent": true,
      "isSample": true
    },
    {
      "input": "[-1,2,-3]",
      "expected": "[[],[-1],[2],[-1,2],[-3],[-1,-3],[2,-3],[-1,2,-3]]",
      "is_single_array_arg": true,
      "orderIndependent": true,
      "isSample": false
    },
    {
      "input": "[5]",
      "expected": "[[],[5]]",
      "is_single_array_arg": true,
      "orderIndependent": true,
      "isSample": false
    },
    {
      "input": "[1,2,3,4]",
      "expected": "[[],[1],[2],[3],[4],[1,2],[1,3],[1,4],[2,3],[2,4],[3,4],[1,2,3],[1,2,4],[1,3,4],[2,3,4],[1,2,3,4]]",
      "is_single_array_arg": true,
      "orderIndependent": true,
      "isSample": false
    },
    {
      "input": "[-2,-1,0]",
      "expected": "[[],[-2],[-1],[-2,-1],[0],[-2,0],[-1,0],[-2,-1,0]]",
      "is_single_array_arg": true,
      "orderIndependent": true,
      "isSample": false
    }
  ]
}
