{
  "title": "Combinations",
  "difficulty": "medium",
  "args": ["integer", "integer"],
  "returnType": "integer[][]",
  "constraints": [
    "1 <= n <= 20",
    "1 <= k <= n"
  ],
  "description": "Given two integers `n` and `k`, return all possible combinations of `k` numbers chosen from the range `[1, n]`.\n\nYou may return the answer in **any order**.",
  "tests": [
    {
      "input": "[4, 2]",
      "expected": "[[1,2],[1,3],[1,4],[2,3],[2,4],[3,4]]",
      "explanation": "6 combinations of 2 from 4.",
      "isSample": true,
      "orderIndependent": true
    },
    {
      "input": "[1, 1]",
      "expected": "[[1]]",
      "explanation": "Only one combination.",
      "isSample": true
    }
  ]
}
