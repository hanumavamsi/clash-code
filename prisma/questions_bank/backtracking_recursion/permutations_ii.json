{
  "title": "Permutations II",
  "difficulty": "medium",
  "args": ["integer[]"],
  "returnType": "integer[][]",
  "constraints": [
    "1 <= nums.length <= 8",
    "-10 <= nums[i] <= 10"
  ],
  "description": "Given a collection of numbers, `nums`,  that might contain duplicates, return all possible permutations in **any order**.",
  "tests": [
    {
      "input": "[1,1,2]",
      "expected": "[[1,1,2],[1,2,1],[2,1,1]]",
      "explanation": "3 unique permutations.",
      "isSample": true,
      "orderIndependent": true
    },
    {
      "input": "[0,1]",
      "expected": "[[0,1],[1,0]]",
      "explanation": "2 permutations.",
      "isSample": true,
      "orderIndependent": true
    }
  ]
}
