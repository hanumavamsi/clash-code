    {"input": "[\"abc\", \"cba\"]", "expected": "\"abc\"", "is_single_array_arg": false, "isSample": false},
    {"input": "[\"ab\", \"b\"]", "expected": "\"b\"", "is_single_array_arg": false, "isSample": false},
