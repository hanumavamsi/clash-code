{
  "title": "Palindrome Partitions in Array",
  "difficulty": "hard",
  "args": ["integer[]"],
  "returnType": "integer",
  "constraints": [
    "1 <= nums.length <= 100",
    "1 <= nums[i] <= 100"
  ],
  "description": "Given an array of integers `nums`, find the minimum number of cuts needed such that every resulting subarray is a palindrome when treated as a sequence.",
  "tests": [
    {
      "input": "[1,2,1]",
      "expected": "0",
      "explanation": "Already a palindrome, no cuts needed.",
      "isSample": true
    },
    {
      "input": "[1,2,3,2,1]",
      "expected": "0",
      "explanation": "The entire array is a palindrome.",
      "isSample": true
    },
    {
      "input": "[1,2,3]",
      "expected": "2",
      "explanation": "Cut into [1],[2],[3].",
      "isSample": false
    },
    {
      "input": "[1,1,1,1]",
      "expected": "0",
      "explanation": "Already palindrome.",
      "isSample": false
    },
    {
      "input": "[1,2,1,3]",
      "expected": "1",
      "explanation": "[1,2,1] and [3].",
      "isSample": false
    },
    {
      "input": "[5,4,3,4,5]",
      "expected": "0",
      "explanation": "Palindrome.",
      "isSample": false
    },
    {
      "input": "[1,2,3,4,5]",
      "expected": "4",
      "explanation": "Each cut individually.",
      "isSample": false
    },
    {
      "input": "[2,2,1,1,3]",
      "expected": "2",
      "explanation": "[2,2], [1,1], [3].",
      "isSample": false
    },
    {
      "input": "[1]",
      "expected": "0",
      "explanation": "Single element.",
      "isSample": false
    },
    {
      "input": "[3,3]",
      "expected": "0",
      "explanation": "Palindrome.",
      "isSample": false
    },
    {
      "input": "[1,2,1,2,1]",
      "expected": "0",
      "explanation": "Palindrome.",
      "isSample": false
    },
    {
      "input": "[1,2,3,2,1,4]",
      "expected": "1",
      "explanation": "[1,2,3,2,1] and [4].",
      "isSample": false
    },
    {
      "input": "[5,1,2,3,4]",
      "expected": "4",
      "explanation": "No palindromic subarrays except singles.",
      "isSample": false
    },
    {
      "input": "[2,1,1,2]",
      "expected": "0",
      "explanation": "Palindrome.",
      "isSample": false
    },
    {
      "input": "[1,2,2,1,3]",
      "expected": "1",
      "explanation": "[1,2,2,1] and [3].",
      "isSample": false
    },
    {
      "input": "[10,10]",
      "expected": "0",
      "explanation": "Palindrome.",
      "isSample": false
    },
    {
      "input": "[1,2,3,3,2,1]",
      "expected": "0",
      "explanation": "Palindrome.",
      "isSample": false
    },
    {
      "input": "[7,8,9,10]",
      "expected": "3",
      "explanation": "No palindromes.",
      "isSample": false
    },
    {
      "input": "[4,4,4,4]",
      "expected": "0",
      "explanation": "All same, palindrome.",
      "isSample": false
    },
    {
      "input": "[1,3,1,2,2,1]",
      "expected": "1",
      "explanation": "[1,3,1] and [2,2,1]? No. [1,3,1,2,2,1] is not palindrome. [1,3,1], [2,2,1].",
      "isSample": false
    },
    {
      "input": "[5,4,5]",
      "expected": "0",
      "explanation": "Palindrome.",
      "isSample": false
    }
  ]
}
