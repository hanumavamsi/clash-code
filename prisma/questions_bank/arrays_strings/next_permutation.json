{
  "title": "Next Permutation",
  "difficulty": "medium",
  "args": ["integer[]"],
  "returnType": "integer[]",
  "constraints": [
    "1 <= nums.length <= 100",
    "0 <= nums[i] <= 100"
  ],
  "description": "A **permutation** of an array of integers is an arrangement of its members into a sequence or linear order.\n\nGiven an array of integers `nums`, find the next permutation of `nums`.\n\nThe **next permutation** of an array of integers is the next lexicographically greater permutation of its integer. If no such arrangement is possible, the array must be rearranged to the lowest possible order (i.e., sorted in ascending order).\n\nReturn the result array.",
  "tests": [
    {"input": "[1,2,3]", "expected": "[1,3,2]", "explanation": "The next permutation of [1,2,3] is [1,3,2].", "isSample": true},
    {"input": "[3,2,1]", "expected": "[1,2,3]", "explanation": "This is the last permutation, so it wraps to the first.", "isSample": true},
    {"input": "[1,1,5]", "expected": "[1,5,1]", "isSample": true},
    {"input": "[1]", "expected": "[1]", "isSample": false},
    {"input": "[1,2]", "expected": "[2,1]", "isSample": false},
    {"input": "[2,1]", "expected": "[1,2]", "isSample": false},
    {"input": "[1,3,2]", "expected": "[2,1,3]", "isSample": false},
    {"input": "[2,3,1]", "expected": "[3,1,2]", "isSample": false},
    {"input": "[3,1,2]", "expected": "[3,2,1]", "isSample": false},
    {"input": "[2,1,3]", "expected": "[2,3,1]", "isSample": false},
    {"input": "[1,2,3,4]", "expected": "[1,2,4,3]", "isSample": false},
    {"input": "[4,3,2,1]", "expected": "[1,2,3,4]", "isSample": false},
    {"input": "[1,1,1]", "expected": "[1,1,1]", "isSample": false},
    {"input": "[2,2,2]", "expected": "[2,2,2]", "isSample": false},
    {"input": "[1,2,3,4,5]", "expected": "[1,2,3,5,4]", "isSample": false},
    {"input": "[5,4,3,2,1]", "expected": "[1,2,3,4,5]", "isSample": false},
    {"input": "[1,5,4,3,2]", "expected": "[2,1,3,4,5]", "isSample": false},
    {"input": "[1,2,4,3]", "expected": "[1,3,2,4]", "isSample": false},
    {"input": "[2,3,1,4]", "expected": "[2,3,4,1]", "isSample": false},
    {"input": "[1,4,3,2]", "expected": "[2,1,3,4]", "isSample": false},
    {"input": "[0,1,2]", "expected": "[0,2,1]", "isSample": false},
    {"input": "[2,1,0]", "expected": "[0,1,2]", "isSample": false},
    {"input": "[1,2,3,6,5,4]", "expected": "[1,2,4,3,5,6]", "isSample": false},
    {"input": "[3,2,1,5,4]", "expected": "[3,2,4,1,5]", "isSample": false},
    {"input": "[1,3,2,4,3]", "expected": "[1,3,2,3,4]", "isSample": false},
    {"input": "[5,1,1]", "expected": "[1,1,5]", "isSample": false}
  ]
}
