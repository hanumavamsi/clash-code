{
  "title": "3Sum",
  "difficulty": "medium",
  "args": ["integer[]"],
  "returnType": "integer[][]",
  "constraints": [
    "3 <= nums.length <= 3000",
    "-10^5 <= nums[i] <= 10^5"
  ],
  "description": "Given an integer array `nums`, return all the triplets `[nums[i], nums[j], nums[k]]` such that `i != j`, `i != k`, and `j != k`, and `nums[i] + nums[j] + nums[k] == 0`.\n\nThe solution set must **not contain duplicate triplets**. You may return the answer in any order.",
  "tests": [
    {"input": "[-1,0,1,2,-1,-4]", "expected": "[[-1,-1,2],[-1,0,1]]", "explanation": "nums[0] + nums[1] + nums[2] = -1 + 0 + 1 = 0. nums[1] + nums[2] + nums[4] = 0 + 1 + (-1) = 0.", "isSample": true},
    {"input": "[0,1,1]", "expected": "[]", "explanation": "No triplet sums to zero.", "isSample": true},
    {"input": "[0,0,0]", "expected": "[[0,0,0]]", "isSample": true},
    {"input": "[-2,0,1,1,2]", "expected": "[[-2,0,2],[-2,1,1]]", "isSample": false},
    {"input": "[-4,-1,-1,0,1,2]", "expected": "[[-1,-1,2],[-1,0,1]]", "isSample": false},
    {"input": "[1,2,3]", "expected": "[]", "isSample": false},
    {"input": "[-1,-1,-1,2]", "expected": "[[-1,-1,2]]", "isSample": false},
    {"input": "[0,0,0,0]", "expected": "[[0,0,0]]", "isSample": false},
    {"input": "[-5,2,3]", "expected": "[]", "isSample": false},
    {"input": "[-2,-2,4]", "expected": "[[-2,-2,4]]", "isSample": false},
    {"input": "[-1,0,1,0]", "expected": "[[-1,0,1]]", "isSample": false},
    {"input": "[-3,-2,-1,0,1,2,3]", "expected": "[[-3,0,3],[-3,1,2],[-2,-1,3],[-2,0,2],[-1,0,1],[-1,-1,2]]", "isSample": false},
    {"input": "[1,-1,0]", "expected": "[[-1,0,1]]", "isSample": false},
    {"input": "[-2,0,0,2,2]", "expected": "[[-2,0,2]]", "isSample": false},
    {"input": "[3,0,-2,-1,1,2]", "expected": "[[-2,-1,3],[-2,0,2],[-1,0,1]]", "isSample": false},
    {"input": "[-1,0,0,1]", "expected": "[[-1,0,1]]", "isSample": false},
    {"input": "[-4,-2,1,3,2,-1]", "expected": "[[-4,1,3],[-4,2,2],[-2,-1,3],[-2,0,2],[-1,0,1]]", "isSample": false},
    {"input": "[100000,-50000,-50000]", "expected": "[[-50000,-50000,100000]]", "isSample": false},
    {"input": "[-1,-1,2]", "expected": "[[-1,-1,2]]", "isSample": false},
    {"input": "[0,0,0,0,0]", "expected": "[[0,0,0]]", "isSample": false},
    {"input": "[-2,1,1]", "expected": "[[-2,1,1]]", "isSample": false},
    {"input": "[-1,2,-1]", "expected": "[[-1,-1,2]]", "isSample": false},
    {"input": "[-3,3,4,-3,1,2]", "expected": "[[-3,-1,4],[-3,1,2],[-3,0,3]]", "isSample": false},
    {"input": "[1,1,-2]", "expected": "[[-2,1,1]]", "isSample": false},
    {"input": "[-5,-3,-2,0,1,4,4]", "expected": "[[-5,1,4],[-3,-2,5],[-3,0,3],[-2,-2,4]]", "isSample": false},
    {"input": "[-2,-1,0,1,3]", "expected": "[[-2,-1,3],[-2,0,2],[-1,0,1]]", "isSample": false}
  ]
}
