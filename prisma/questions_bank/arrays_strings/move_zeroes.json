{
  "title": "Move Zeroes",
  "difficulty": "easy",
  "args": ["integer[]"],
  "returnType": "integer[]",
  "constraints": [
    "1 <= nums.length <= 10^4",
    "-2^31 <= nums[i] <= 2^31 - 1"
  ],
  "description": "Given an integer array `nums`, move all `0`s to the end of it while maintaining the relative order of the non-zero elements.\n\nReturn the modified array. Note that you must do this **in-place** without making a copy of the array.",
  "tests": [
    {"input": "[0,1,0,3,12]", "expected": "[1,3,12,0,0]", "explanation": "Non-zero elements 1, 3, 12 maintain their relative order.", "isSample": true},
    {"input": "[0]", "expected": "[0]", "isSample": true},
    {"input": "[1]", "expected": "[1]", "isSample": true},
    {"input": "[0,0,0]", "expected": "[0,0,0]", "isSample": false},
    {"input": "[1,2,3]", "expected": "[1,2,3]", "isSample": false},
    {"input": "[0,0,1]", "expected": "[1,0,0]", "isSample": false},
    {"input": "[1,0,0]", "expected": "[1,0,0]", "isSample": false},
    {"input": "[4,2,4,0,0,3,0,5,1,0]", "expected": "[4,2,4,3,5,1,0,0,0,0]", "isSample": false},
    {"input": "[0,1]", "expected": "[1,0]", "isSample": false},
    {"input": "[1,0]", "expected": "[1,0]", "isSample": false},
    {"input": "[0,0,1,0,2]", "expected": "[1,2,0,0,0]", "isSample": false},
    {"input": "[-1,0,0,-2]", "expected": "[-1,-2,0,0]", "isSample": false},
    {"input": "[1,2,0,3,0,4]", "expected": "[1,2,3,4,0,0]", "isSample": false},
    {"input": "[0,0,0,1]", "expected": "[1,0,0,0]", "isSample": false},
    {"input": "[5,0,0,0,0]", "expected": "[5,0,0,0,0]", "isSample": false},
    {"input": "[1,0,2,0,3]", "expected": "[1,2,3,0,0]", "isSample": false},
    {"input": "[0,1,0,0,2,0,3]", "expected": "[1,2,3,0,0,0,0]", "isSample": false},
    {"input": "[10,0,0,0,5]", "expected": "[10,5,0,0,0]", "isSample": false},
    {"input": "[0,0,0,0,0]", "expected": "[0,0,0,0,0]", "isSample": false},
    {"input": "[1,1,1,0,0]", "expected": "[1,1,1,0,0]", "isSample": false},
    {"input": "[-1,0,1,-2,0,2]", "expected": "[-1,1,-2,2,0,0]", "isSample": false},
    {"input": "[0,0,0,4,5]", "expected": "[4,5,0,0,0]", "isSample": false},
    {"input": "[3,2,1]", "expected": "[3,2,1]", "isSample": false},
    {"input": "[0,100]", "expected": "[100,0]", "isSample": false},
    {"input": "[5,0,5]", "expected": "[5,5,0]", "isSample": false},
    {"input": "[0,1,2,0,3,4,0,5]", "expected": "[1,2,3,4,5,0,0,0]", "isSample": false}
  ]
}
