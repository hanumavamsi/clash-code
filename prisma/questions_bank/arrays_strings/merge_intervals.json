{
  "title": "Merge Intervals",
  "difficulty": "medium",
  "args": ["integer[][]"],
  "returnType": "integer[][]",
  "constraints": [
    "1 <= intervals.length <= 10^4",
    "intervals[i].length == 2",
    "0 <= start_i <= end_i <= 10^4"
  ],
  "description": "Given an array of `intervals` where `intervals[i] = [start_i, end_i]`, merge all overlapping intervals, and return an array of the non-overlapping intervals that cover all the intervals in the input.",
  "tests": [
    {"input": "[[1,3],[2,6],[8,10],[15,18]]", "expected": "[[1,6],[8,10],[15,18]]", "explanation": "Intervals [1,3] and [2,6] overlap, so they are merged into [1,6].", "isSample": true},
    {"input": "[[1,4],[4,5]]", "expected": "[[1,5]]", "explanation": "Intervals [1,4] and [4,5] are considered overlapping.", "isSample": true},
    {"input": "[[1,4],[0,4]]", "expected": "[[0,4]]", "isSample": true},
    {"input": "[[1,4],[2,3]]", "expected": "[[1,4]]", "isSample": false},
    {"input": "[[1,4]]", "expected": "[[1,4]]", "isSample": false},
    {"input": "[[1,2],[3,4],[5,6]]", "expected": "[[1,2],[3,4],[5,6]]", "isSample": false},
    {"input": "[[1,10],[2,3],[4,5]]", "expected": "[[1,10]]", "isSample": false},
    {"input": "[[0,0]]", "expected": "[[0,0]]", "isSample": false},
    {"input": "[[1,3],[3,5],[5,7]]", "expected": "[[1,7]]", "isSample": false},
    {"input": "[[2,3],[4,5],[6,7],[8,9],[1,10]]", "expected": "[[1,10]]", "isSample": false},
    {"input": "[[0,1],[3,4]]", "expected": "[[0,1],[3,4]]", "isSample": false},
    {"input": "[[5,10],[1,3],[2,7]]", "expected": "[[1,10]]", "isSample": false},
    {"input": "[[1,5],[2,4],[3,6]]", "expected": "[[1,6]]", "isSample": false},
    {"input": "[[1,2],[2,3],[3,4],[4,5]]", "expected": "[[1,5]]", "isSample": false},
    {"input": "[[0,10000]]", "expected": "[[0,10000]]", "isSample": false},
    {"input": "[[1,3],[6,9]]", "expected": "[[1,3],[6,9]]", "isSample": false},
    {"input": "[[0,2],[3,5],[4,7],[6,8]]", "expected": "[[0,2],[3,8]]", "isSample": false},
    {"input": "[[1,4],[0,1]]", "expected": "[[0,4]]", "isSample": false},
    {"input": "[[3,5],[1,2],[4,6],[7,9]]", "expected": "[[1,2],[3,6],[7,9]]", "isSample": false},
    {"input": "[[1,1],[1,1]]", "expected": "[[1,1]]", "isSample": false},
    {"input": "[[0,4],[1,2],[3,6],[5,7]]", "expected": "[[0,7]]", "isSample": false},
    {"input": "[[2,6],[1,3],[8,10],[15,18]]", "expected": "[[1,6],[8,10],[15,18]]", "isSample": false},
    {"input": "[[1,4],[0,2],[3,5]]", "expected": "[[0,5]]", "isSample": false},
    {"input": "[[10,20],[1,5],[5,10]]", "expected": "[[1,20]]", "isSample": false},
    {"input": "[[1,3],[2,6],[8,10]]", "expected": "[[1,6],[8,10]]", "isSample": false},
    {"input": "[[0,0],[1,1],[2,2]]", "expected": "[[0,0],[1,1],[2,2]]", "isSample": false}
  ]
}
