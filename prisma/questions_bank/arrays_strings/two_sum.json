{
  "title": "Two Sum",
  "difficulty": "easy",
  "args": [
    "integer[]",
    "integer"
  ],
  "returnType": "integer[]",
  "constraints": [
    "2 <= nums.length <= 10^4",
    "-10^9 <= nums[i] <= 10^9",
    "-10^9 <= target <= 10^9",
    "Only one valid answer exists."
  ],
  "description": "Given an array of integers `nums` and an integer `target`, return **indices** of the two numbers such that they add up to `target`.\n\nYou may assume that each input would have **exactly one solution**, and you may not use the same element twice.\n\nYou can return the answer in any order.",
  "tests": [
    {
      "input": "[[2,7,11,15], 9]",
      "expected": "[0,1]",
      "explanation": "Because nums[0] + nums[1] == 9, we return [0, 1].",
      "is_single_array_arg": false,
      "orderIndependent": true,
      "isSample": true
    },
    {
      "input": "[[3,2,4], 6]",
      "expected": "[1,2]",
      "is_single_array_arg": false,
      "orderIndependent": true,
      "isSample": true
    },
    {
      "input": "[[3,3], 6]",
      "expected": "[0,1]",
      "is_single_array_arg": false,
      "orderIndependent": true,
      "isSample": true
    },
    {
      "input": "[[-3,4,3,90], 0]",
      "expected": "[0,2]",
      "is_single_array_arg": false,
      "orderIndependent": true,
      "isSample": false
    },
    {
      "input": "[[1,2,3,4,5], 9]",
      "expected": "[3,4]",
      "is_single_array_arg": false,
      "orderIndependent": true,
      "isSample": false
    },
    {
      "input": "[[0,4,3,0], 0]",
      "expected": "[0,3]",
      "is_single_array_arg": false,
      "orderIndependent": true,
      "isSample": false
    },
    {
      "input": "[[-1,-2,-3,-4,-5], -8]",
      "expected": "[2,4]",
      "is_single_array_arg": false,
      "orderIndependent": true,
      "isSample": false
    },
    {
      "input": "[[1,5,8,10], 13]",
      "expected": "[1,2]",
      "is_single_array_arg": false,
      "orderIndependent": true,
      "isSample": false
    }
  ]
}
