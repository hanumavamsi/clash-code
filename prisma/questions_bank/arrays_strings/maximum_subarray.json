{
  "title": "Maximum Subarray",
  "difficulty": "medium",
  "args": ["integer[]"],
  "returnType": "integer",
  "constraints": [
    "1 <= nums.length <= 10^5",
    "-10^4 <= nums[i] <= 10^4"
  ],
  "description": "Given an integer array `nums`, find the subarray with the largest sum, and return its sum.\n\nA **subarray** is a contiguous non-empty sequence of elements within an array.",
  "tests": [
    {"input": "[-2,1,-3,4,-1,2,1,-5,4]", "expected": "6", "explanation": "The subarray [4,-1,2,1] has the largest sum 6.", "isSample": true},
    {"input": "[1]", "expected": "1", "explanation": "The only element is the subarray.", "isSample": true},
    {"input": "[5,4,-1,7,8]", "expected": "23", "explanation": "The entire array is the subarray.", "isSample": true},
    {"input": "[-1]", "expected": "-1", "isSample": false},
    {"input": "[-2,-1]", "expected": "-1", "isSample": false},
    {"input": "[1,2,3,4,5]", "expected": "15", "isSample": false},
    {"input": "[-5,-3,-1,-4]", "expected": "-1", "isSample": false},
    {"input": "[0,0,0,0]", "expected": "0", "isSample": false},
    {"input": "[10,-1,10]", "expected": "19", "isSample": false},
    {"input": "[-1,2,-1]", "expected": "2", "isSample": false},
    {"input": "[2,-1,2,-1,2]", "expected": "4", "isSample": false},
    {"input": "[-10000,10000]", "expected": "10000", "isSample": false},
    {"input": "[1,-1,1,-1,1,-1,1]", "expected": "1", "isSample": false},
    {"input": "[3,-1,2,-1]", "expected": "4", "isSample": false},
    {"input": "[-2,1]", "expected": "1", "isSample": false},
    {"input": "[1,-2,3,-4,5]", "expected": "5", "isSample": false},
    {"input": "[100,-50,100]", "expected": "150", "isSample": false},
    {"input": "[-1,0,1]", "expected": "1", "isSample": false},
    {"input": "[0,-1,0]", "expected": "0", "isSample": false},
    {"input": "[1,2,-5,4,3]", "expected": "7", "isSample": false},
    {"input": "[-3,1,2,-1,3,-2]", "expected": "5", "isSample": false},
    {"input": "[5,-3,5]", "expected": "7", "isSample": false},
    {"input": "[-2,3,-1,4,-2,5,-1]", "expected": "9", "isSample": false},
    {"input": "[1,1,1,1,1,-100,1,1,1,1,1]", "expected": "5", "isSample": false},
    {"input": "[-1,2,3,-2,5]", "expected": "8", "isSample": false},
    {"input": "[4,-2,3,-1,2]", "expected": "6", "isSample": false}
  ]
}
