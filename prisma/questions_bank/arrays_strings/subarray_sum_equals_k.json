{
  "title": "Subarray Sum Equals K",
  "difficulty": "medium",
  "args": ["integer[]", "integer"],
  "returnType": "integer",
  "constraints": [
    "1 <= nums.length <= 2 * 10^4",
    "-1000 <= nums[i] <= 1000",
    "-10^7 <= k <= 10^7"
  ],
  "description": "Given an array of integers `nums` and an integer `k`, return the total number of subarrays whose sum equals to `k`.\n\nA **subarray** is a contiguous non-empty sequence of elements within an array.",
  "tests": [
    {"input": "[[1,1,1], 2]", "expected": "2", "explanation": "Subarrays [1,1] at index 0 and [1,1] at index 1 both sum to 2.", "is_single_array_arg": false, "isSample": true},
    {"input": "[[1,2,3], 3]", "expected": "2", "is_single_array_arg": false, "isSample": true},
    {"input": "[[1], 0]", "expected": "0", "is_single_array_arg": false, "isSample": true},
    {"input": "[[1,1,1], 1]", "expected": "3", "is_single_array_arg": false, "isSample": false},
    {"input": "[[1,2,1,2,1], 3]", "expected": "4", "is_single_array_arg": false, "isSample": false},
    {"input": "[[-1,-1,1], 0]", "expected": "1", "is_single_array_arg": false, "isSample": false},
    {"input": "[[0,0,0,0], 0]", "expected": "10", "is_single_array_arg": false, "isSample": false},
    {"input": "[[1], 1]", "expected": "1", "is_single_array_arg": false, "isSample": false},
    {"input": "[[1,2,3,4,5], 5]", "expected": "2", "is_single_array_arg": false, "isSample": false},
    {"input": "[[1,-1,0], 0]", "expected": "3", "is_single_array_arg": false, "isSample": false},
    {"input": "[[3,4,7,2,-3,1,4,2], 7]", "expected": "4", "is_single_array_arg": false, "isSample": false},
    {"input": "[[-1,1,-1,1], 0]", "expected": "4", "is_single_array_arg": false, "isSample": false},
    {"input": "[[1,2,3,4,5], 15]", "expected": "1", "is_single_array_arg": false, "isSample": false},
    {"input": "[[1,2,3], 6]", "expected": "1", "is_single_array_arg": false, "isSample": false},
    {"input": "[[1,2,3], 0]", "expected": "0", "is_single_array_arg": false, "isSample": false},
    {"input": "[[0], 0]", "expected": "1", "is_single_array_arg": false, "isSample": false},
    {"input": "[[1,2,-3,4], 0]", "expected": "1", "is_single_array_arg": false, "isSample": false},
    {"input": "[[10,-10,10,-10], 0]", "expected": "4", "is_single_array_arg": false, "isSample": false},
    {"input": "[[2,4,-2,1,-1,0,-1,3,1], 0]", "expected": "6", "is_single_array_arg": false, "isSample": false},
    {"input": "[[100,200,300], 300]", "expected": "2", "is_single_array_arg": false, "isSample": false},
    {"input": "[[-1,-2,-3], -3]", "expected": "2", "is_single_array_arg": false, "isSample": false},
    {"input": "[[1,2,3,4,5], 9]", "expected": "2", "is_single_array_arg": false, "isSample": false},
    {"input": "[[1,0,1,0,1], 2]", "expected": "4", "is_single_array_arg": false, "isSample": false},
    {"input": "[[5,5,5], 10]", "expected": "2", "is_single_array_arg": false, "isSample": false},
    {"input": "[[1,2,3,-3,-2,-1], 0]", "expected": "3", "is_single_array_arg": false, "isSample": false},
    {"input": "[[1,2,3,4,-4,-3,-2,-1], 0]", "expected": "4", "is_single_array_arg": false, "isSample": false}
  ]
}
