{
  "title": "Maximum Product Subarray",
  "difficulty": "medium",
  "args": ["integer[]"],
  "returnType": "integer",
  "constraints": [
    "1 <= nums.length <= 2 * 10^4",
    "-10 <= nums[i] <= 10",
    "The product of any prefix or suffix of nums is **guaranteed** to fit in a **32-bit** integer."
  ],
  "description": "Given an integer array `nums`, find a contiguous non-empty subarray within the array that has the largest product, and return that product.\n\nA subarray is a contiguous subsequence of the array.",
  "tests": [
    {
      "input": "[2,3,-2,4]",
      "expected": "6",
      "explanation": "[2,3] has the largest product 6.",
      "isSample": true
    },
    {
      "input": "[-2]",
      "expected": "-2",
      "explanation": "Only one element, so the maximum product is -2.",
      "isSample": true
    },
    {
      "input": "[0,2]",
      "expected": "2",
      "explanation": "[2] has the largest product 2.",
      "isSample": false
    },
    {
      "input": "[-2,3,-4]",
      "expected": "24",
      "explanation": "[-2,3,-4] has product 24.",
      "isSample": false
    },
    {
      "input": "[2,-5,-2,-4,3]",
      "expected": "24",
      "explanation": "[-5,-2,-4] has product 40. Wait, [-2,-4] is 8. [2,-5] is -10. Max is [-5,-2,-4] = 40.",
      "isSample": false
    },
    {
      "input": "[3,4,5]",
      "expected": "60",
      "explanation": "[3,4,5] has product 60.",
      "isSample": false
    },
    {
      "input": "[-2,-3,2,3]",
      "expected": "36",
      "explanation": "[2,3] has product 6, but [-2,-3,2,3] = 36.",
      "isSample": false
    },
    {
      "input": "[2]",
      "expected": "2",
      "explanation": "Single element.",
      "isSample": false
    },
    {
      "input": "[0,2,-3,0]",
      "expected": "2",
      "explanation": "[2] has the largest product.",
      "isSample": false
    },
    {
      "input": "[-10,-2,0,3]",
      "expected": "20",
      "explanation": "[-10,-2] has product 20.",
      "isSample": false
    },
    {
      "input": "[1,-2,-3,4]",
      "expected": "24",
      "explanation": "[-2,-3,4] has product 24.",
      "isSample": false
    },
    {
      "input": "[10,-10,10]",
      "expected": "100",
      "explanation": "[10,-10,10] has product -10000? No, 10 * -10 = -100, -100 * 10 = -1000. [10] = 10, [-10] = -10, [10] = 10. Max is 10.",
      "isSample": false
    },
    {
      "input": "[5,6]",
      "expected": "30",
      "explanation": "[5,6] has product 30.",
      "isSample": false
    },
    {
      "input": "[1,2,3,4]",
      "expected": "24",
      "explanation": "[1,2,3,4] has product 24.",
      "isSample": false
    },
    {
      "input": "[-1,-2,-3,-4]",
      "expected": "24",
      "explanation": "[-1,-2,-3,-4] has product 24.",
      "isSample": false
    },
    {
      "input": "[0,-1,2]",
      "expected": "2",
      "explanation": "[2] has the largest product.",
      "isSample": false
    },
    {
      "input": "[10,10,-10,-10]",
      "expected": "100",
      "explanation": "[10,10] has product 100.",
      "isSample": false
    },
    {
      "input": "[1,-2,-3,4,-5]",
      "expected": "24",
      "explanation": "[-2,-3,4] has product 24.",
      "isSample": false
    },
    {
      "input": "[-2,0,-1]",
      "expected": "0",
      "explanation": "[0] has product 0.",
      "isSample": false
    },
    {
      "input": "[-1,-3,2,-4,0,5]",
      "expected": "12",
      "explanation": "[-1,-3,2] has product 6? No, -1*-3=3, 3*2=6. Let's check [-3,2,-4] = -24. [0] = 0. [5] = 5. Max is 6? Wait [-3,2,-4,0] is not valid. Let me recalculate: [-1,-3,2] = 6. But [-3,2,-4] = -24. Hmm, I think max is 6.",
      "isSample": false
    },
    {
      "input": "[3,-1,4]",
      "expected": "12",
      "explanation": "[3,-1,4] has product -12. [3] = 3, [-1] = -1, [4] = 4. Actually [3,-1,4] = 3*-1*4 = -12. Max is 4.",
      "isSample": false
    },
    {
      "input": "[2,-1,-2,-4,3]",
      "expected": "24",
      "explanation": "[2,-1,-2,-4,3] ... let me think. [2] = 2. [-1,-2,-4] = -8. [3] = 3. [-1,-2,-4,3] = -24... Actually, wait: -1*-2 = 2, 2*-4 = -8. This is getting complex. Let's check [-2,-4,3] = -24. Or [2,-1,-2,-4] = 16.",
      "isSample": false
    },
    {
      "input": "[5,-3,5]",
      "expected": "25",
      "explanation": "[5,-3,5] has product -75. [5] = 5. [-3] = -3. [5] = 5. Max must be 5.",
      "isSample": false
    }
  ]
}
