{
  "title": "Product of Array Except Self",
  "difficulty": "medium",
  "args": ["integer[]"],
  "returnType": "integer[]",
  "constraints": [
    "2 <= nums.length <= 10^5",
    "-30 <= nums[i] <= 30",
    "The product of any prefix or suffix of nums is guaranteed to fit in a 32-bit integer."
  ],
  "description": "Given an integer array `nums`, return an array `answer` such that `answer[i]` is equal to the product of all the elements of `nums` except `nums[i]`.\n\nYou must write an algorithm that runs in `O(n)` time and **without using the division operation**.",
  "tests": [
    {"input": "[1,2,3,4]", "expected": "[24,12,8,6]", "explanation": "For index 0: 2*3*4=24, index 1: 1*3*4=12, etc.", "isSample": true},
    {"input": "[-1,1,0,-3,3]", "expected": "[0,0,9,0,0]", "isSample": true},
    {"input": "[2,3]", "expected": "[3,2]", "isSample": true},
    {"input": "[1,1]", "expected": "[1,1]", "isSample": false},
    {"input": "[0,0]", "expected": "[0,0]", "isSample": false},
    {"input": "[1,0]", "expected": "[0,1]", "isSample": false},
    {"input": "[5,5,5,5]", "expected": "[125,125,125,125]", "isSample": false},
    {"input": "[-1,-2,-3,-4]", "expected": "[-24,-12,-8,-6]", "isSample": false},
    {"input": "[1,2,0,4]", "expected": "[0,0,8,0]", "isSample": false},
    {"input": "[0,1,2,3]", "expected": "[6,0,0,0]", "isSample": false},
    {"input": "[1,-1,1,-1]", "expected": "[1,-1,1,-1]", "isSample": false},
    {"input": "[2,2,2,2,2]", "expected": "[16,16,16,16,16]", "isSample": false},
    {"input": "[1,2,3]", "expected": "[6,3,2]", "isSample": false},
    {"input": "[-2,3,-4]", "expected": "[-12,8,-6]", "isSample": false},
    {"input": "[10,3,5,6,2]", "expected": "[180,600,360,300,900]", "isSample": false},
    {"input": "[1,1,1,1,1]", "expected": "[1,1,1,1,1]", "isSample": false},
    {"input": "[0,0,0]", "expected": "[0,0,0]", "isSample": false},
    {"input": "[2,-3,0,4]", "expected": "[0,0,-24,0]", "isSample": false},
    {"input": "[3,2,1]", "expected": "[2,3,6]", "isSample": false},
    {"input": "[-1,2,-3,4]", "expected": "[-24,12,-8,6]", "isSample": false},
    {"input": "[5,1,2,3]", "expected": "[6,30,15,10]", "isSample": false},
    {"input": "[1,10,1]", "expected": "[10,1,10]", "isSample": false},
    {"input": "[2,0,0]", "expected": "[0,0,0]", "isSample": false},
    {"input": "[1,2,3,4,5]", "expected": "[120,60,40,30,24]", "isSample": false},
    {"input": "[-1,0,1]", "expected": "[0,-1,0]", "isSample": false},
    {"input": "[4,3,2,1]", "expected": "[6,8,12,24]", "isSample": false}
  ]
}
