{
  "title": "Find the Duplicate Number",
  "difficulty": "medium",
  "args": ["integer[]"],
  "returnType": "integer",
  "constraints": [
    "n + 1 integers where n = nums.length - 1",
    "1 <= nums[i] <= n",
    "All integers in nums appear only once except for precisely one integer which appears two or more times.",
    "2 <= nums.length <= 10^5"
  ],
  "description": "Given an array of integers `nums` containing `n + 1` integers where each integer is in the range `[1, n]` inclusive.\n\nThere is only **one repeated number** in `nums`, return this repeated number.\n\nYou must solve the problem **without** modifying the array and uses only constant extra space.",
  "tests": [
    {"input": "[1,3,4,2,2]", "expected": "2", "explanation": "2 appears twice.", "isSample": true},
    {"input": "[3,1,3,4,2]", "expected": "3", "isSample": true},
    {"input": "[3,3,3,3,3]", "expected": "3", "isSample": true},
    {"input": "[1,1]", "expected": "1", "isSample": false},
    {"input": "[2,2,2,2]", "expected": "2", "isSample": false},
    {"input": "[1,2,3,4,5,5]", "expected": "5", "isSample": false},
    {"input": "[2,1,3,4,2]", "expected": "2", "isSample": false},
    {"input": "[1,2,2,3,4]", "expected": "2", "isSample": false},
    {"input": "[4,3,2,1,4]", "expected": "4", "isSample": false},
    {"input": "[1,2,3,3,4]", "expected": "3", "isSample": false},
    {"input": "[1,2,3,4,4]", "expected": "4", "isSample": false},
    {"input": "[5,1,2,3,4,5]", "expected": "5", "isSample": false},
    {"input": "[2,3,4,5,1,1]", "expected": "1", "isSample": false},
    {"input": "[1,1,2]", "expected": "1", "isSample": false},
    {"input": "[2,2,1]", "expected": "2", "isSample": false},
    {"input": "[3,2,1,3]", "expected": "3", "isSample": false},
    {"input": "[4,1,4,2,3]", "expected": "4", "isSample": false},
    {"input": "[1,2,3,4,5,6,6]", "expected": "6", "isSample": false},
    {"input": "[3,1,2,3]", "expected": "3", "isSample": false},
    {"input": "[1,2,1,3,4]", "expected": "1", "isSample": false},
    {"input": "[2,1,4,3,2]", "expected": "2", "isSample": false},
    {"input": "[5,4,3,2,1,5]", "expected": "5", "isSample": false},
    {"input": "[2,5,9,6,9,3,8,9,7,1]", "expected": "9", "isSample": false},
    {"input": "[1,4,4,2,3]", "expected": "4", "isSample": false},
    {"input": "[3,4,1,4,2]", "expected": "4", "isSample": false},
    {"input": "[6,5,4,3,2,1,6]", "expected": "6", "isSample": false}
  ]
}
