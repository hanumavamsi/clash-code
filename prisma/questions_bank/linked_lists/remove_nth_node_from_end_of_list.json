{
  "title": "Remove Nth Node From End of List",
  "difficulty": "medium",
  "args": [
    "integer[]",
    "integer"
  ],
  "returnType": "integer[]",
  "constraints": [
    "1 <= sz <= 30",
    "0 <= Node.val <= 100",
    "1 <= n <= sz",
    "List is represented as an array of node values"
  ],
  "description": "Given the `head` of a linked list (as an array) and an integer `n`, remove the **`n`th node from the end** of the list and return the modified list.\n\n```text\nInput:  [1, 2, 3, 4, 5],  n = 2\n\n               ^\n        (2nd from end)\n\nOutput: [1, 2, 3, 5]\n```",
  "tests": [
    {
      "input": "[[1,2,3,4,5], 2]",
      "expected": "[1,2,3,5]",
      "explanation": "The 2nd node from the end is node with value 4. After removing it, the list is [1,2,3,5].",
      "is_single_array_arg": false,
      "isSample": true
    },
    {
      "input": "[[1], 1]",
      "expected": "[]",
      "explanation": "Removing the only node returns an empty list.",
      "is_single_array_arg": false,
      "isSample": true
    },
    {
      "input": "[[1,2], 1]",
      "expected": "[1]",
      "is_single_array_arg": false,
      "isSample": true
    },
    {
      "input": "[[1,2,3,4,5], 5]",
      "expected": "[2,3,4,5]",
      "is_single_array_arg": false,
      "isSample": false
    },
    {
      "input": "[[1,2,3,4,5], 1]",
      "expected": "[1,2,3,4]",
      "is_single_array_arg": false,
      "isSample": false
    },
    {
      "input": "[[1,2], 2]",
      "expected": "[2]",
      "is_single_array_arg": false,
      "isSample": false
    },
    {
      "input": "[[1,2,3], 2]",
      "expected": "[1,3]",
      "is_single_array_arg": false,
      "isSample": false
    },
    {
      "input": "[[5,10,15,20,25], 3]",
      "expected": "[5,10,20,25]",
      "is_single_array_arg": false,
      "isSample": false
    }
  ]
}
