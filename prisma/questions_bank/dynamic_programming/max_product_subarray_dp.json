{
  "title": "Maximum Product Subarray DP",
  "difficulty": "medium",
  "args": ["integer[]"],
  "returnType": "integer",
  "constraints": [
    "1 <= nums.length <= 2 * 10^4",
    "-10 <= nums[i] <= 10"
  ],
  "description": "Given an integer array `nums`, find a contiguous non-empty subarray within the array that has the largest product, and return that product.",
  "tests": [
    {
      "input": "[2,3,-2,4]",
      "expected": "6",
      "explanation": "[2,3] has largest product 6.",
      "isSample": true
    },
    {
      "input": "[-2]",
      "expected": "-2",
      "explanation": "Only one element.",
      "isSample": true
    }
  ]
}
