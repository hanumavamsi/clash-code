{
  "title": "Pow(x, n)",
  "difficulty": "medium",
  "args": ["double", "integer"],
  "returnType": "double",
  "constraints": [
    "-100.0 < x < 100.0",
    "-2^31 <= n <= 2^31 - 1"
  ],
  "description": "Implement `pow(x, n)`, which calculates `x` raised to the power `n` (i.e., $x^n$).",
  "tests": [
    {
      "input": "[2.00, 10]",
      "expected": "1024.00",
      "explanation": "2^10 = 1024.",
      "isSample": true
    },
    {
      "input": "[2.10, 3]",
      "expected": "9.261",
      "explanation": "2.1^3 = 9.261.",
      "isSample": true
    }
  ]
}
