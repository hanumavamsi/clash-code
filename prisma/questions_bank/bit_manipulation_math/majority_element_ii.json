{
  "title": "Majority Element II",
  "difficulty": "medium",
  "args": ["integer[]"],
  "returnType": "integer[]",
  "constraints": [
    "1 <= nums.length <= 5 * 10^4",
    "-10^9 <= nums[i] <= 10^9"
